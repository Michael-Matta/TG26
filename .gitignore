# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Ignore texture files in SourceArt and similar folders
SourceArt/**/*.png
SourceArt/**/*.tga
SourceArt/**/*.jpg
SourceArt/**/*.jpeg
SourceArt/**/*.bmp
SourceArt/**/*.dds
SourceArt/**/*.ktx
SourceArt/**/*.hdr
SourceArt/**/*.exr
SourceArt/**/*.tiff
SourceArt/**/*.webp

# Ignore Plugins ALL RUNTIME FOLDER
Plugins/Runtime/

# Ignore files in Content
Content/ThirdParty/
Content/Chaotic_Skies
Content/ExampleContent
Content/Global
Content/Animated_Nebulas_Starter_Pack/
Content/Fab/
Content/Megaplant_Library/
Content/ParagonZinx/
Content/NiagaraExamples/
Content/Lyra/
Content/Variant_Platforming/
Content/UI/
Content/TG26/Textures
Content/TG26/Landscape/Textures
Content/**/*.png
Content/**/*.tga
Content/**/*.jpg
Content/**/*.jpeg
Content/**/*.bmp
Content/**/*.dds
Content/**/*.ktx
Content/**/*.hdr
Content/**/*.exr
Content/**/*.tiff
Content/**/*.webp

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
